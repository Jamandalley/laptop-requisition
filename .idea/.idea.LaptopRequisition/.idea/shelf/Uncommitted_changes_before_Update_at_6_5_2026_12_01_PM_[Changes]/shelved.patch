+                "staffid" => isDesc ? query.OrderByDescending(x => x.StaffId) : query.OrderBy(x => x.StaffId),
+                "createdat" => isDesc ? query.OrderByDescending(x => x.CreatedAt) : query.OrderBy(x => x.CreatedAt),
+                _ => query.OrderBy(x => x.FullName)
